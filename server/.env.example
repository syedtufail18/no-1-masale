# Example environment file for the mail/review server.
# The current npm scripts load the project-root .env file.

# SMTP settings (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
# For Gmail, create an app password and put it here (DO NOT commit real secrets)
SMTP_PASS=your-gmail-app-password

# FROM and TO addresses (optional)
FROM_EMAIL=your-email@gmail.com
TO_EMAIL=your-business-email@example.com

# Hosted review database and private image storage (Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_REVIEW_BUCKET=review-images
REVIEW_ADMIN_EMAIL=your-business-email@example.com
REVIEW_ADMIN_BASE_URL=http://127.0.0.1:3001

# server port
PORT=3001

# Review moderation token. Keep this secret and send it as a Bearer token
# when approving or rejecting reviews through /admin/reviews.
ADMIN_REVIEW_TOKEN=replace-with-a-long-random-token

# Maximum uploaded review image size in megabytes
REVIEW_UPLOAD_MAX_MB=5
