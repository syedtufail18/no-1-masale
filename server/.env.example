# Example environment file for the mail server
# Copy to server/.env and fill the values before running

# SMTP settings (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
# For Gmail, create an app password and put it here (DO NOT commit real secrets)
SMTP_PASS=your-gmail-app-password

# FROM and TO addresses (optional)
FROM_EMAIL=your-email@gmail.com
TO_EMAIL=your-business-email@example.com

# server port
PORT=3001
