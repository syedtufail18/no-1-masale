PORT=3001
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=your-email@gmail.com
TO_EMAIL=your-business-email@example.com

# Hosted review database and private image storage (Supabase).
# Keep the service-role key server-side; never expose it as VITE_ data.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_REVIEW_BUCKET=review-images
ADMIN_REVIEW_TOKEN=replace-with-a-long-random-token
REVIEW_ADMIN_EMAIL=your-business-email@example.com
REVIEW_ADMIN_BASE_URL=http://127.0.0.1:3001
REVIEW_UPLOAD_MAX_MB=5

# Public contact values used by the Vite frontend. Do not put SMTP secrets here.
VITE_BUSINESS_EMAIL=your-business-email@example.com
VITE_BUSINESS_PHONE=
VITE_WHATSAPP_NUMBER=
VITE_API_BASE_URL=http://127.0.0.1:3001
